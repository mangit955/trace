{
  "name": "trace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "dev": "bun run apps/agent/src/repl.ts",
    "start": "bun run apps/agent/src/main.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "capture:reasoning": "bun run packages/reasoner/scripts/capture.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.13",
    "typescript": "^5.9.3"
  }
}
